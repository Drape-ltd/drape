{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["drape", "vision"],
  "ios": {
    "iosModuleName": "DrapeVision"
  },
  "android": {
    "androidNamespace": ["drape", "vision"],
    "androidCxxLibName": "DrapeVision"
  },
  "autolinking": {
    "DrapePoseLandmarker": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDrapePoseLandmarker"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDrapePoseLandmarker"
      }
    },
    "DrapeHandLandmarker": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDrapeHandLandmarker"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDrapeHandLandmarker"
      }
    },
    "DrapeFaceLandmarker": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDrapeFaceLandmarker"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDrapeFaceLandmarker"
      }
    },
    "DrapeImageSegmenter": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDrapeImageSegmenter"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDrapeImageSegmenter"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
