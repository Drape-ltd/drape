// Drape V1 — Prisma Schema
// Auth users are managed by Supabase Auth (auth.users).
// All tables reference user_id as a plain String (the auth UUID) — no FK to auth.users.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum GarmentContext {
  MENSWEAR
  WOMENSWEAR
  BOTH
  PREFER_NOT_TO_SAY

  @@map("garment_context")
}

enum UserRole {
  CUSTOMER
  TAILOR

  @@map("user_role")
}

enum BodyShape {
  RECTANGLE
  BROAD_SHOULDERS
  FULL_HIPS
  DEFINED_WAIST
  FULL_MIDSECTION
  ATHLETIC
  PREFER_NOT_TO_SAY

  @@map("body_shape")
}

enum FitStyle {
  SLIM
  REGULAR
  RELAXED

  @@map("fit_style")
}

enum TailorTier {
  VERIFIED
  RISING
  MASTER

  @@map("tailor_tier")
}

enum AvailabilityStatus {
  OPEN
  LIMITED
  FULLY_BOOKED

  @@map("availability_status")
}

enum SellerType {
  TAILOR
  BOUTIQUE
  TAILOR_SHOP

  @@map("seller_type")
}

enum FabricSource {
  CUSTOMER_SUPPLIES
  TAILOR_SOURCES

  @@map("fabric_source")
}

enum DeliveryMethod {
  SHIPPING
  LOCAL_DELIVERY
  LOCAL_COLLECTION

  @@map("delivery_method")
}

enum OrderKind {
  CUSTOM
  READY_MADE

  @@map("order_kind")
}

enum OrderStage {
  DRAFT
  PENDING_QUOTE
  CONSULTATION
  QUOTE_SENT
  PAYMENT_PENDING
  PAYMENT_FAILED
  CONFIRMED
  DESIGNING
  SOURCING
  CUTTING
  SEWING
  FINISHING
  READY_FOR_DRAPE_DISPATCH
  OUT_FOR_DELIVERY
  SHIPPED
  READY_FOR_COLLECTION
  DELIVERED
  COLLECTED
  COMPLETE
  PARTIALLY_REFUNDED
  DECLINED
  EXPIRED
  IN_DISPUTE
  REFUNDED
  CANCELLED

  @@map("order_stage")
}

enum Currency {
  GBP
  USD
  EUR
  NGN
  GHS
  KES
  CAD

  @@map("currency")
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
  COVERAGE

  @@map("payment_provider")
}

enum OrderPaymentPhase {
  INITIAL_ORDER
  CONSULTATION
  FULFILLMENT
  MATERIAL_ADVANCE
  ADJUSTMENT
  TIP

  @@map("order_payment_phase")
}

enum OrderPaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  PARTIAL_REFUND
  REFUNDED

  @@map("order_payment_status")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  BLOCKED
  PAID
  FAILED
  REVERSED
  CANCELED

  @@map("payout_status")
}

enum PayoutAccountType {
  PAYSTACK
  STRIPE_CONNECT

  @@map("payout_account_type")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_RELEASED

  @@map("dispute_status")
}

enum ClientType {
  ON_DRAPE
  PRIVATE

  @@map("client_type")
}

enum MessageType {
  TEXT
  PHOTO
  VOICE_NOTE

  @@map("message_type")
}

// ─────────────────────────────────────────────
// CUSTOMER PROFILE
// Keyed on user_id (Supabase auth UUID).
// ─────────────────────────────────────────────

model CustomerProfile {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  displayName String? @map("display_name")

  // JSONB blob — written by the measurements wizard in the mobile app.
  // Shape: { chest, waist, hips, inseam, shoulder, sleeveLength, neck, height,
  //          unit ("cm"|"in"), fitStyle, garmentContext, bodyShape, fitFlags[], bodyNote }
  measurements Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

model PublicUser {
  id                  String   @id
  email               String   @unique
  displayName         String   @map("display_name")
  role                UserRole
  phone               String?
  defaultCurrency     Currency @default(USD) @map("default_currency")
  currencyConfirmedAt DateTime @default(now()) @map("currency_confirmed_at")
  currencySource      String   @default("UNSUPPORTED_FALLBACK") @map("currency_source")
  regionCode          String   @default("ZZ") @map("region_code")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model MeasurementScan {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  captureMethod        String   @map("capture_method")
  captureVersion       String   @default("guided-fit-v1") @map("capture_version")
  status               String   @default("CAPTURED")
  confidenceOverall    String?  @map("confidence_overall")
  confidenceByField    Json     @default("{}") @map("confidence_by_field")
  measurementSnapshot  Json     @default("{}") @map("measurement_snapshot")
  garmentPreferences   Json     @default("{}") @map("garment_preferences")
  bodyFlags            String[] @default([]) @map("body_flags")
  symmetryFlags        String[] @default([]) @map("symmetry_flags")
  requiresTailorReview Boolean  @default(false) @map("requires_tailor_review")
  sourceDevice         Json?    @map("source_device")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("measurement_scans")
}

// ─────────────────────────────────────────────
// TAILOR PROFILE
// ─────────────────────────────────────────────

model TailorProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  displayName                    String             @map("display_name")
  businessName                   String?            @map("business_name")
  sellerType                     SellerType         @default(TAILOR) @map("seller_type")
  bio                            String?
  location                       String             @default("")
  languages                      String[]
  specialtyTags                  String[]           @map("specialty_tags")
  priceRangeMin                  Int?               @map("price_range_min")
  priceRangeMax                  Int?               @map("price_range_max")
  currency                       Currency           @default(USD)
  payoutCurrency                 Currency           @default(USD) @map("payout_currency")
  payoutProvider                 PaymentProvider?   @map("payout_provider")
  payoutReverificationRequired   Boolean            @default(false) @map("payout_reverification_required")
  payoutAccountType              PayoutAccountType? @map("payout_account_type")
  payoutAccountVerified          Boolean            @default(false) @map("payout_account_verified")
  payoutBankName                 String?            @map("payout_bank_name")
  payoutBankCode                 String?            @map("payout_bank_code")
  payoutAccountName              String?            @map("payout_account_name")
  payoutAccountMasked            String?            @map("payout_account_masked")
  payoutCountryCode              String?            @map("payout_country_code")
  manualBankEntry                Boolean            @default(false) @map("manual_bank_entry")
  manualBankName                 String?            @map("manual_bank_name")
  manualBankCountryCode          String?            @map("manual_bank_country_code")
  manualBankCountryName          String?            @map("manual_bank_country_name")
  manualBankSwiftBic             String?            @map("manual_bank_swift_bic")
  manualBankAccountNumber        String?            @map("manual_bank_account_number")
  manualBankAccountName          String?            @map("manual_bank_account_name")
  manualBankVerificationStatus   String             @default("NOT_SUBMITTED") @map("manual_bank_verification_status")
  manualBankSubmittedAt          DateTime?          @map("manual_bank_submitted_at")
  manualBankVerifiedAt           DateTime?          @map("manual_bank_verified_at")
  manualBankVerifiedBy           String?            @map("manual_bank_verified_by")
  paystackRecipientCode          String?            @map("paystack_recipient_code")
  stripeConnectAccountId         String?            @map("stripe_connect_account_id")
  payoutAccountVerifiedAt        DateTime?          @map("payout_account_verified_at")
  payoutAccountChangeCount       Int                @default(0) @map("payout_account_change_count")
  payoutAccountLastChangedAt     DateTime?          @map("payout_account_last_changed_at")
  payoutAccountChangeLockedUntil DateTime?          @map("payout_account_change_locked_until")
  payoutDestinationHoldUntil     DateTime?          @map("payout_destination_hold_until")
  tier                           TailorTier         @default(VERIFIED)
  availability                   AvailabilityStatus @default(OPEN)
  isVerified                     Boolean            @default(false) @map("is_verified")
  isLive                         Boolean            @default(false) @map("is_live")
  avgRating                      Float              @default(0) @map("avg_rating")
  totalReviews                   Int                @default(0) @map("total_reviews")
  totalOrders                    Int                @default(0) @map("total_orders")
  avgResponseHours               Float?             @map("avg_response_hours")
  supportsCustomOrders           Boolean            @default(true) @map("supports_custom_orders")
  supportsReadyMade              Boolean            @default(false) @map("supports_ready_made")
  pickupAvailable                Boolean            @default(false) @map("pickup_available")
  deliveryAvailable              Boolean            @default(false) @map("delivery_available")
  shippingAvailable              Boolean            @default(false) @map("shipping_available")
  consultationMode               String             @default("FREE") @map("consultation_mode")
  consultationRequirement        String             @default("OPTIONAL") @map("consultation_requirement")
  consultationFeeAmount          Int?               @map("consultation_fee_amount")
  consultationCurrency           Currency?          @map("consultation_currency")
  consultationDurationMinutes    Int                @default(30) @map("consultation_duration_minutes")
  consultationCallType           String             @default("VIDEO") @map("consultation_call_type")
  consultationFeeCreditable      Boolean            @default(false) @map("consultation_fee_creditable")
  consultationPolicyVersion      String             @default("consultation-2026-07-31-v1") @map("consultation_policy_version")
  consultationPolicyPublishedAt  DateTime?          @map("consultation_policy_published_at")
  deliveryFee                    Int                @default(0) @map("delivery_fee")
  shippingFee                    Int                @default(0) @map("shipping_fee")
  shipsInternationally           Boolean            @default(false) @map("ships_internationally")
  stripeAccountId                String?            @map("stripe_account_id")
  paystackAccountId              String?            @map("paystack_account_id")
  idVerificationStatus           String             @default("NOT_SUBMITTED") @map("id_verification_status")
  idDocumentPath                 String?            @map("id_document_path")
  idDocumentUrl                  String?            @map("id_document_url")
  idVerifiedAt                   DateTime?          @map("id_verified_at")
  // Flat URL array written by the setup wizard (source of truth for mobile)
  portfolioPhotoUrls             String[]           @map("portfolio_photo_urls")
  bypassAttempts                 Int                @default(0) @map("bypass_attempts")
  tierLostAt                     DateTime?          @map("tier_lost_at")
  createdAt                      DateTime           @default(now()) @map("created_at")
  updatedAt                      DateTime           @updatedAt @map("updated_at")

  portfolioPhotos PortfolioPhoto[]
  sellerItems     SellerItem[]
  orders          Order[]
  clients         TailorClient[]
  reviews         Review[]
  payouts         Payout[]

  @@map("tailor_profiles")
}

model TailorPickupDetail {
  userId                              String    @id @map("user_id")
  pickupAddress                       String?   @map("pickup_address")
  pickupInstructions                  String?   @map("pickup_instructions")
  pickupAddressLine1                  String?   @map("pickup_address_line1")
  pickupCity                          String?   @map("pickup_city")
  pickupRegion                        String?   @map("pickup_region")
  pickupPostalCode                    String?   @map("pickup_postal_code")
  pickupCountryCode                   String?   @map("pickup_country_code")
  pickupLocationVerificationSource    String?   @map("pickup_location_verification_source")
  pickupLocationVerificationReference String?   @map("pickup_location_verification_reference")
  pickupLocationVerifiedAt            DateTime? @map("pickup_location_verified_at")
  createdAt                           DateTime  @default(now()) @map("created_at")
  updatedAt                           DateTime  @updatedAt @map("updated_at")

  @@map("tailor_pickup_details")
}

model OrderHandoffIssue {
  id             String    @id @default(uuid())
  orderId        String    @map("order_id")
  reporterId     String    @map("reporter_id")
  reporterRole   String    @map("reporter_role")
  issueType      String    @map("issue_type")
  description    String?
  stageAtReport  String    @map("stage_at_report")
  deliveryMethod String?   @map("delivery_method")
  status         String    @default("OPEN")
  escalatedAt    DateTime? @map("escalated_at")
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("order_handoff_issues")
}

model TailorPayoutSetupRequest {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  provider          String
  currency          String
  country           String
  accountHolderName String    @map("account_holder_name")
  businessName      String?   @map("business_name")
  payoutDetails     String    @map("payout_details")
  note              String?
  status            String    @default("PENDING")
  reviewedAt        DateTime? @map("reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("tailor_payout_setup_requests")
}

// ─────────────────────────────────────────────
// PORTFOLIO PHOTOS (admin / CDN record)
// ─────────────────────────────────────────────

model PortfolioPhoto {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  storagePath   String    @map("storage_path")
  publicUrl     String    @map("public_url")
  caption       String?
  displayOrder  Int       @default(0) @map("display_order")
  ocrFlagged    Boolean   @default(false) @map("ocr_flagged")
  ocrReviewedAt DateTime? @map("ocr_reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("portfolio_photos")
}

model SellerItem {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  title             String
  description       String?
  category          String?
  sizes             String[]
  priceAmount       Int      @map("price_amount")
  currency          Currency @default(USD)
  photoUrls         String[] @default([]) @map("photo_urls")
  isReadyMade       Boolean  @default(true) @map("is_ready_made")
  isLive            Boolean  @default(false) @map("is_live")
  stockStatus       String   @default("IN_STOCK") @map("stock_status")
  inventoryQuantity Int      @default(0) @map("inventory_quantity")
  sizeInventory     Json     @default("{}") @map("size_inventory")
  sizeGuide         Json     @default("{}") @map("size_guide")
  pickupAvailable   Boolean  @default(false) @map("pickup_available")
  deliveryAvailable Boolean  @default(false) @map("delivery_available")
  shippingAvailable Boolean  @default(false) @map("shipping_available")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("seller_items")
}

// ─────────────────────────────────────────────
// TAILOR CRM — ON DRAPE CLIENTS (private fit notes)
// ─────────────────────────────────────────────

model TailorClientNote {
  id         String   @id @default(uuid())
  tailorId   String   @map("tailor_id") // tailor auth UUID
  customerId String   @map("customer_id") // customer auth UUID
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tailorId, customerId])
  @@map("tailor_client_notes")
}

// ─────────────────────────────────────────────
// TAILOR CRM — PRIVATE (offline) CLIENTS
// ─────────────────────────────────────────────

model TailorClient {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  clientType          ClientType @default(PRIVATE) @map("client_type")
  linkedUserId        String?    @map("linked_user_id")
  name                String
  email               String?
  phone               String?
  chestCm             Float?     @map("chest_cm")
  waistCm             Float?     @map("waist_cm")
  hipsCm              Float?     @map("hips_cm")
  shoulderWidthCm     Float?     @map("shoulder_width_cm")
  inseamCm            Float?     @map("inseam_cm")
  sleeveLengthCm      Float?     @map("sleeve_length_cm")
  neckCircumferenceCm Float?     @map("neck_circumference_cm")
  heightCm            Float?     @map("height_cm")
  fitNotes            String?    @map("fit_notes")
  generalNotes        String?    @map("general_notes")
  inviteToken         String?    @unique @map("invite_token")
  inviteSentAt        DateTime?  @map("invite_sent_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  offlineOrders OfflineOrder[]

  @@map("tailor_clients")
}

// ─────────────────────────────────────────────
// OFFLINE ORDERS
// ─────────────────────────────────────────────

model OfflineOrder {
  id             String       @id @default(uuid())
  tailorClientId String       @map("tailor_client_id")
  tailorClient   TailorClient @relation(fields: [tailorClientId], references: [id], onDelete: Cascade)

  garmentType String    @map("garment_type")
  description String?
  price       Int?
  currency    Currency  @default(USD)
  status      String    @default("completed")
  notes       String?
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("offline_orders")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id         String @id @default(uuid())
  reference  String @unique @default(cuid())
  customerId String @map("customer_id") // customer auth UUID
  tailorId   String @map("tailor_id") // tailor auth UUID

  // Optional FK to tailor_profiles for joins (populated on order creation)
  tailorProfileId   String?        @map("tailor_profile_id")
  tailorProfile     TailorProfile? @relation(fields: [tailorProfileId], references: [id])
  orderKind         OrderKind      @default(CUSTOM) @map("order_kind")
  sellerItemId      String?        @map("seller_item_id")
  fulfillmentOption String?        @map("fulfillment_option")

  garmentType                        String           @map("garment_type")
  garmentDescription                 String?          @map("garment_description")
  itemTitle                          String?          @map("item_title")
  itemSize                           String?          @map("item_size")
  itemQuantity                       Int              @default(1) @map("item_quantity")
  itemUnitPrice                      Int?             @map("item_unit_price")
  itemSubtotal                       Int?             @map("item_subtotal")
  fulfillmentFee                     Int              @default(0) @map("fulfillment_fee")
  occasion                           String?
  deadline                           DateTime?
  fabricSource                       FabricSource?    @map("fabric_source")
  deliveryMethod                     DeliveryMethod?  @map("delivery_method")
  deliveryAddress                    String?          @map("delivery_address")
  deliveryCity                       String?          @map("delivery_city")
  deliveryRegion                     String?          @map("delivery_region")
  deliveryPostalCode                 String?          @map("delivery_postal_code")
  deliveryCountryCode                String?          @map("delivery_country_code")
  fulfillmentContractVersion         String?          @map("fulfillment_contract_version")
  fulfillmentPolicyVersion           String?          @map("fulfillment_policy_version")
  fulfillmentClassification          String?          @map("fulfillment_classification")
  fulfillmentOriginSnapshot          Json?            @map("fulfillment_origin_snapshot")
  fulfillmentDestinationSnapshot     Json?            @map("fulfillment_destination_snapshot")
  fulfillmentCorridorControlId       String?          @map("fulfillment_corridor_control_id")
  fulfillmentCollectionMode          String?          @map("fulfillment_collection_mode")
  fulfillmentFingerprint             String?          @map("fulfillment_fingerprint")
  fulfillmentResolvedAt              DateTime?        @map("fulfillment_resolved_at")
  pricingInvalidatedAt               DateTime?        @map("pricing_invalidated_at")
  pricingInvalidationReason          String?          @map("pricing_invalidation_reason")
  recipientName                      String?          @map("recipient_name")
  recipientPhone                     String?          @map("recipient_phone")
  fulfillmentProvider                String?          @map("fulfillment_provider")
  fulfillmentReference               String?          @map("fulfillment_reference")
  fulfillmentContactName             String?          @map("fulfillment_contact_name")
  fulfillmentContactPhone            String?          @map("fulfillment_contact_phone")
  specialNote                        String?          @map("special_note")
  fabricTracking                     String?          @map("fabric_tracking")
  trackingNumber                     String?          @map("tracking_number")
  carrier                            String?
  referencePhotos                    String[]         @default([]) @map("reference_photos")
  customerMeasurementsSnapshot       Json?            @map("customer_measurements_snapshot")
  fitNote                            String?          @map("fit_note")
  consultationFee                    Int?             @map("consultation_fee")
  quotedAmount                       Int?             @map("quoted_amount")
  currency                           Currency         @default(USD)
  quotedCompletionDate               DateTime?        @map("quoted_completion_date")
  quoteNote                          String?          @map("quote_note")
  quoteExpiresAt                     DateTime?        @map("quote_expires_at")
  stage                              OrderStage       @default(DRAFT)
  stageUpdatedAt                     DateTime         @default(now()) @map("stage_updated_at")
  paymentProvider                    PaymentProvider? @map("payment_provider")
  paymentIntentId                    String?          @map("payment_intent_id")
  paymentCheckoutUrl                 String?          @map("payment_checkout_url")
  fulfillmentPaymentRequestedAt      DateTime?        @map("fulfillment_payment_requested_at")
  fulfillmentPaymentPaidAt           DateTime?        @map("fulfillment_payment_paid_at")
  fulfillmentPaymentProvider         PaymentProvider? @map("fulfillment_payment_provider")
  fulfillmentPaymentIntentId         String?          @map("fulfillment_payment_intent_id")
  fulfillmentPaymentCheckoutUrl      String?          @map("fulfillment_payment_checkout_url")
  videoCallUrl                       String?          @map("video_call_url")
  escrowReleased                     Boolean          @default(false) @map("escrow_released")
  escrowReleasedAt                   DateTime?        @map("escrow_released_at")
  autoReleaseAt                      DateTime?        @map("auto_release_at")
  handoffCompletedAt                 DateTime?        @map("handoff_completed_at")
  customerHandoffConfirmedAt         DateTime?        @map("customer_handoff_confirmed_at")
  handoffConfirmationSource          String?          @map("handoff_confirmation_source")
  collectionCode                     String?          @map("collection_code")
  collectionCodeExpiry               DateTime?        @map("collection_code_expiry")
  collectionCodeUsed                 Boolean          @default(false) @map("collection_code_used")
  sourceCurrency                     Currency?        @map("source_currency")
  sourceAmount                       Int?             @map("source_amount")
  tailorPayoutCurrencyLocked         Currency?        @map("tailor_payout_currency_locked")
  tailorPayoutProviderLocked         PaymentProvider? @map("tailor_payout_provider_locked")
  tailorPaystackRecipientCodeLocked  String?          @map("tailor_paystack_recipient_code_locked")
  tailorStripeConnectAccountIdLocked String?          @map("tailor_stripe_connect_account_id_locked")
  opsPayoutResolutionMode            String?          @map("ops_payout_resolution_mode")
  opsPayoutOverrideCurrency          Currency?        @map("ops_payout_override_currency")
  opsPayoutOverrideProvider          PaymentProvider? @map("ops_payout_override_provider")
  opsPayoutOverrideAmount            Int?             @map("ops_payout_override_amount")
  opsPayoutOverrideFxRate            Decimal?         @map("ops_payout_override_fx_rate") @db.Decimal(18, 8)
  opsPayoutOverrideFxRateTimestamp   DateTime?        @map("ops_payout_override_fx_rate_timestamp")
  opsPayoutOverrideNote              String?          @map("ops_payout_override_note")
  opsPayoutOverrideSetAt             DateTime?        @map("ops_payout_override_set_at")
  opsPayoutOverrideSetBy             String?          @map("ops_payout_override_set_by")
  fxRate                             Decimal?         @map("fx_rate") @db.Decimal(18, 8)
  fxRateTimestamp                    DateTime?        @map("fx_rate_timestamp")
  subtotalAmount                     Int              @default(0) @map("subtotal_amount")
  platformFeeAmount                  Int              @default(0) @map("platform_fee_amount")
  taxAmount                          Int              @default(0) @map("tax_amount")
  taxRateBps                         Int              @default(0) @map("tax_rate_bps")
