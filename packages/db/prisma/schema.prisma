  @@index([tailorId, updatedAt])
  @@map("order_fabric_funding_allocations")
}

model OrderFabricCandidate {
  id                      String   @id @default(uuid())
  orderId                 String   @map("order_id")
  allocationId            String   @map("allocation_id")
  customerId              String   @map("customer_id")
  tailorId                String   @map("tailor_id")
  componentCode           String   @map("component_code")
  candidateVersion        Int      @default(1) @map("candidate_version")
  supplierCostAmount      Int      @map("supplier_cost_amount")
  currency                Currency
  allowanceAppliedAmount  Int      @default(0) @map("allowance_applied_amount")
  shortfallSubtotalAmount Int      @default(0) @map("shortfall_subtotal_amount")
  shortfallTaxAmount      Int      @default(0) @map("shortfall_tax_amount")
  shortfallFeeAmount      Int      @default(0) @map("shortfall_fee_amount")
  estimateStorageBucket   String   @default("commercial-evidence") @map("estimate_storage_bucket")
  estimateStoragePath     String   @map("estimate_storage_path")
  customerMedia           Json     @default("[]") @map("customer_media")
  availabilityNote        String   @map("availability_note")
  quantitySpecification   String   @map("quantity_specification")
  deadlineImpact          String   @map("deadline_impact")
  deadlineImpactNote      String?  @map("deadline_impact_note")
  status                  String   @default("DRAFT")
  customerDecision        String?  @map("customer_decision")
  customerReasonCode      String?  @map("customer_reason_code")
  customerNote            String?  @map("customer_note")
  shortfallPaymentId      String?  @map("shortfall_payment_id")
  payoutId                String?  @map("payout_id")
  provider                String?
  providerStatus          String   @default("NOT_REQUESTED") @map("provider_status")
  providerReference       String?  @map("provider_reference")
  providerResponse        Json     @default("{}") @map("provider_response")
  receiptStorageBucket    String?  @map("receipt_storage_bucket")
  receiptStoragePath      String?  @map("receipt_storage_path")
  acquiredMedia           Json     @default("[]") @map("acquired_media")
  actualSpendAmount       Int?     @map("actual_spend_amount")
  reconciliationStatus    String   @default("PENDING") @map("reconciliation_status")
  policyVersion           String   @map("policy_version")
  correlationId           String   @default(uuid()) @map("correlation_id")
  idempotencyKey          String   @unique @map("idempotency_key")
  submittedAt             DateTime @default(now()) @map("submitted_at")
  customerDecidedAt       DateTime? @map("customer_decided_at")
  releaseQueuedAt         DateTime? @map("release_queued_at")
  releaseConfirmedAt      DateTime? @map("release_confirmed_at")
  reconciledAt            DateTime? @map("reconciled_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([orderId, componentCode, candidateVersion])
  @@index([orderId, status, submittedAt])
  @@map("order_fabric_candidates")
}

model OrderFabricHandoff {
  id                  String    @id @default(uuid())
  orderId             String    @unique @map("order_id")
  customerId          String    @map("customer_id")
  tailorId            String    @map("tailor_id")
  mode                 String
  status               String   @default("AWAITING_HANDOFF")
  carrier              String?
  trackingNumber       String?  @map("tracking_number")
  trackingUrl          String?  @map("tracking_url")
  scheduledAt          DateTime? @map("scheduled_at")
  timezone             String?
  handoffLocation      String?  @map("handoff_location")
  receivedMedia        Json      @default("[]") @map("received_media")
  suitabilityOutcome   String?   @map("suitability_outcome")
  issueNote            String?   @map("issue_note")
  customerResolution   String?   @map("customer_resolution")
  resolutionNote       String?   @map("resolution_note")
  correlationId        String    @default(uuid()) @map("correlation_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([tailorId, status, updatedAt])
  @@map("order_fabric_handoffs")
}

model OrderFabricEvent {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  candidateId   String?  @map("candidate_id")
  handoffId     String?  @map("handoff_id")
  eventType     String   @map("event_type")
  actorId       String?  @map("actor_id")
  actorRole     String?  @map("actor_role")
  payload       Json     @default("{}")
  correlationId String   @default(uuid()) @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_fabric_events")
}

model CommercialLedgerTransaction {
  id                      String                        @id @default(uuid())
  idempotencyKey          String                        @unique @map("idempotency_key")
  requestHash             String                        @map("request_hash")
  transactionKind         String                        @map("transaction_kind")
  purpose                 String
  orderId                 String?                       @map("order_id")
  paymentId               String?                       @map("payment_id")
  payment                 OrderPayment?                 @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  reversalOfTransactionId String?                       @map("reversal_of_transaction_id")
  reversalOfTransaction   CommercialLedgerTransaction?  @relation("CommercialLedgerReversal", fields: [reversalOfTransactionId], references: [id], onDelete: Restrict)
  reversals               CommercialLedgerTransaction[] @relation("CommercialLedgerReversal")
  policyVersion           String                        @map("policy_version")
  pricingVersion          Int                           @default(1) @map("pricing_version")
  correlationId           String                        @map("correlation_id")
  actorId                 String?                       @map("actor_id")
  actorRole               String                        @default("SYSTEM") @map("actor_role")
  originalCurrency        Currency                      @map("original_currency")
  originalAmount          Int                           @map("original_amount")
  settlementCurrency      Currency                      @map("settlement_currency")
  settlementAmount        Int                           @map("settlement_amount")
  fxRate                  Decimal                       @default(1) @map("fx_rate") @db.Decimal(18, 8)
  providerFeeAmount       Int                           @default(0) @map("provider_fee_amount")
  providerReference       String?                       @map("provider_reference")
  metadata                Json                          @default("{}")
  occurredAt              DateTime                      @default(now()) @map("occurred_at")
  createdAt               DateTime                      @default(now()) @map("created_at")
  entries                 CommercialLedgerEntry[]
  receipt                 CommercialReceipt?

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("commercial_ledger_transactions")
}

model CommercialReceipt {
  id                         String                       @id @default(uuid())
  receiptNumber              String                       @unique @map("receipt_number")
  receiptVersion             Int                          @default(1) @map("receipt_version")
  orderId                    String                       @map("order_id")
  order                      Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderReference             String                       @map("order_reference")
  paymentId                  String                       @unique @map("payment_id")
  payment                    OrderPayment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  pricingReservationId       String                       @map("pricing_reservation_id")
  pricingReservation         CommercialPricingReservation @relation(fields: [pricingReservationId], references: [id], onDelete: Restrict)
  ledgerTransactionId        String                       @unique @map("ledger_transaction_id")
  ledgerTransaction          CommercialLedgerTransaction  @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  quoteId                    String?                      @map("quote_id")
  customerId                 String                       @map("customer_id")
  tailorId                   String?                      @map("tailor_id")
  purpose                    String
  provider                   PaymentProvider
  providerReference          String                       @map("provider_reference")
  currency                   Currency
  subtotalAmount             Int                          @map("subtotal_amount")
  consultationCreditAmount   Int                          @default(0) @map("consultation_credit_amount")
  promotionAmount            Int                          @default(0) @map("promotion_amount")
  platformFeeAmount          Int                          @default(0) @map("platform_fee_amount")
  taxAmount                  Int                          @default(0) @map("tax_amount")
  shippingAmount             Int                          @default(0) @map("shipping_amount")
  totalAmount                Int                          @map("total_amount")
  taxJurisdiction            String?                      @map("tax_jurisdiction")
  taxSource                  String                       @map("tax_source")
  merchantLabel              String                       @default("Drapeon") @map("merchant_label")
  protectedTailorAmount      Int                          @map("protected_tailor_amount")
  fabricFundingPolicyVersion String?                      @map("fabric_funding_policy_version")
  fabricSourceSnapshot       String?                      @map("fabric_source_snapshot")
  tailoringAmount            Int?                         @map("tailoring_amount")
  fabricAllowanceAmount      Int?                         @map("fabric_allowance_amount")
  fabricAllowanceCoverage    Json?                        @map("fabric_allowance_coverage")
  fabricSourcingAssumptions  String?                      @map("fabric_sourcing_assumptions")
  policyVersion              String                       @map("policy_version")
  pricingVersion             Int                          @map("pricing_version")
  correlationId              String                       @map("correlation_id")
  paidAt                     DateTime                     @map("paid_at")
  issuedAt                   DateTime                     @default(now()) @map("issued_at")

  @@index([customerId, issuedAt])
  @@index([orderId, issuedAt])
  @@index([tailorId, issuedAt])
  @@map("commercial_receipts")
}

model CommercialLedgerEntry {
  id            String                      @id @default(uuid())
  transactionId String                      @map("transaction_id")
  transaction   CommercialLedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  orderId       String?                     @map("order_id")
  accountCode   String                      @map("account_code")
  accountScope  String                      @map("account_scope")
  direction     String
  amount        Int
  currency      Currency
  createdAt     DateTime                    @default(now()) @map("created_at")

  @@index([accountCode, accountScope, currency, createdAt])
  @@index([orderId, createdAt])
  @@map("commercial_ledger_entries")
}

model PaymentWebhookEvent {
  id               String          @id @default(uuid())
  provider         PaymentProvider
  providerEventId  String          @map("provider_event_id")
  eventType        String          @map("event_type")
  idempotencyKey   String?         @map("idempotency_key")
  orderId          String?         @map("order_id")
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentId        String?         @map("payment_id")
  payment          OrderPayment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  signatureValid   Boolean         @default(false) @map("signature_valid")
  payload          Json            @default("{}")
  processedAt      DateTime?       @map("processed_at")
  processingResult String?         @map("processing_result")
  createdAt        DateTime        @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("payment_webhook_events")
}

