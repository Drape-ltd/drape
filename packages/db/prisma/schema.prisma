// Drape V1 — Prisma Schema
// Fields mapped to snake_case to match Supabase PostgreSQL convention.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  TAILOR

  @@map("user_role")
}

enum GarmentContext {
  MENSWEAR
  WOMENSWEAR
  BOTH
  PREFER_NOT_TO_SAY

  @@map("garment_context")
}

enum BodyShape {
  RECTANGLE
  BROAD_SHOULDERS
  FULL_HIPS
  DEFINED_WAIST
  FULL_MIDSECTION
  ATHLETIC
  PREFER_NOT_TO_SAY

  @@map("body_shape")
}

enum FitStyle {
  SLIM
  REGULAR
  RELAXED

  @@map("fit_style")
}

enum TailorTier {
  VERIFIED
  RISING
  MASTER

  @@map("tailor_tier")
}

enum AvailabilityStatus {
  OPEN
  LIMITED
  FULLY_BOOKED

  @@map("availability_status")
}

enum FabricSource {
  CUSTOMER_SUPPLIED
  TAILOR_SOURCES

  @@map("fabric_source")
}

enum DeliveryMethod {
  SHIPPING
  LOCAL_COLLECTION

  @@map("delivery_method")
}

enum OrderStage {
  DRAFT
  PENDING_QUOTE
  QUOTE_SENT
  PAYMENT_PENDING
  CONFIRMED
  CUTTING
  SEWING
  FINISHING
  SHIPPED
  READY_FOR_COLLECTION
  DELIVERED
  COLLECTED
  COMPLETE
  DECLINED
  EXPIRED
  IN_DISPUTE
  REFUNDED
  CANCELLED

  @@map("order_stage")
}

enum Currency {
  GBP
  USD
  EUR
  NGN
  GHS
  KES

  @@map("currency")
}

enum PaymentProvider {
  STRIPE
  PAYSTACK

  @@map("payment_provider")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_RELEASED

  @@map("dispute_status")
}

enum ClientType {
  ON_DRAPE
  PRIVATE

  @@map("client_type")
}

enum MessageType {
  TEXT
  PHOTO
  VOICE_NOTE

  @@map("message_type")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String   @map("display_name")
  role        UserRole
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customerProfile  CustomerProfile?
  tailorProfile    TailorProfile?
  ordersAsCustomer Order[]          @relation("CustomerOrders")
  sentMessages     Message[]        @relation("SentMessages")

  @@map("users")
}

// ─────────────────────────────────────────────
// CUSTOMER PROFILE
// ─────────────────────────────────────────────

model CustomerProfile {
  id      String @id @default(uuid())
  userId  String @unique @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  chestCm              Float?  @map("chest_cm")
  waistCm              Float?  @map("waist_cm")
  hipsCm               Float?  @map("hips_cm")
  shoulderWidthCm      Float?  @map("shoulder_width_cm")
  inseamCm             Float?  @map("inseam_cm")
  sleeveLengthCm       Float?  @map("sleeve_length_cm")
  neckCircumferenceCm  Float?  @map("neck_circumference_cm")
  heightCm             Float?  @map("height_cm")
  fitStyle             FitStyle? @map("fit_style")
  unitPreference       String  @default("cm") @map("unit_preference")
  garmentContext       GarmentContext? @map("garment_context")
  bodyShape            BodyShape?      @map("body_shape")
  fitFlags             String[] @map("fit_flags")
  bodyNote             String?  @map("body_note")
  completionPromptShown Boolean @default(false) @map("completion_prompt_shown")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

// ─────────────────────────────────────────────
// TAILOR PROFILE
// ─────────────────────────────────────────────

model TailorProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName         String   @map("display_name")
  businessName        String?  @map("business_name")
  bio                 String?
  location            String
  languages           String[]
  specialtyTags       String[] @map("specialty_tags")
  priceRangeMin       Int?     @map("price_range_min")
  priceRangeMax       Int?     @map("price_range_max")
  currency            Currency @default(GBP)
  tier                TailorTier @default(VERIFIED)
  availability        AvailabilityStatus @default(OPEN)
  isVerified          Boolean  @default(false) @map("is_verified")
  isLive              Boolean  @default(false) @map("is_live")
  avgRating           Float    @default(0) @map("avg_rating")
  totalReviews        Int      @default(0) @map("total_reviews")
  totalOrders         Int      @default(0) @map("total_orders")
  avgResponseHours    Float?   @map("avg_response_hours")
  shipsInternationally Boolean @default(false) @map("ships_internationally")
  stripeAccountId     String?  @map("stripe_account_id")
  paystackAccountId   String?  @map("paystack_account_id")
  idDocumentPath      String?  @map("id_document_path")
  idVerifiedAt        DateTime? @map("id_verified_at")
  bypassAttempts      Int      @default(0) @map("bypass_attempts")
  tierLostAt          DateTime? @map("tier_lost_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  portfolioPhotos PortfolioPhoto[]
  orders          Order[]          @relation("TailorOrders")
  clients         TailorClient[]
  reviews         Review[]         @relation("TailorReviews")
  payouts         Payout[]

  @@map("tailor_profiles")
}

// ─────────────────────────────────────────────
// PORTFOLIO
// ─────────────────────────────────────────────

model PortfolioPhoto {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  storagePath   String   @map("storage_path")
  publicUrl     String   @map("public_url")
  caption       String?
  displayOrder  Int      @default(0) @map("display_order")
  ocrFlagged    Boolean  @default(false) @map("ocr_flagged")
  ocrReviewedAt DateTime? @map("ocr_reviewed_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("portfolio_photos")
}

// ─────────────────────────────────────────────
// TAILOR CRM — CLIENTS
// ─────────────────────────────────────────────

model TailorClient {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  clientType            ClientType @default(PRIVATE) @map("client_type")
  linkedUserId          String?    @map("linked_user_id")
  name                  String
  email                 String?
  phone                 String?
  chestCm               Float?     @map("chest_cm")
  waistCm               Float?     @map("waist_cm")
  hipsCm                Float?     @map("hips_cm")
  shoulderWidthCm       Float?     @map("shoulder_width_cm")
  inseamCm              Float?     @map("inseam_cm")
  sleeveLengthCm        Float?     @map("sleeve_length_cm")
  neckCircumferenceCm   Float?     @map("neck_circumference_cm")
  heightCm              Float?     @map("height_cm")
  fitNotes              String?    @map("fit_notes")
  generalNotes          String?    @map("general_notes")
  inviteToken           String?    @unique @map("invite_token")
  inviteSentAt          DateTime?  @map("invite_sent_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  offlineOrders OfflineOrder[]

  @@map("tailor_clients")
}

// ─────────────────────────────────────────────
// OFFLINE ORDERS
// ─────────────────────────────────────────────

model OfflineOrder {
  id             String       @id @default(uuid())
  tailorClientId String       @map("tailor_client_id")
  tailorClient   TailorClient @relation(fields: [tailorClientId], references: [id], onDelete: Cascade)

  garmentType  String   @map("garment_type")
  description  String?
  price        Int?
  currency     Currency @default(GBP)
  status       String   @default("completed")
  notes        String?
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("offline_orders")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid())
  reference       String        @unique @default(cuid())
  customerId      String        @map("customer_id")
  customer        User          @relation("CustomerOrders", fields: [customerId], references: [id])
  tailorProfileId String        @map("tailor_profile_id")
  tailor          TailorProfile @relation("TailorOrders", fields: [tailorProfileId], references: [id])

  garmentType           String         @map("garment_type")
  description           String
  occasion              String?
  deadline              DateTime?
  fabricSource          FabricSource   @map("fabric_source")
  deliveryMethod        DeliveryMethod @map("delivery_method")
  specialNote           String?        @map("special_note")
  fabricTracking        String?        @map("fabric_tracking")
  quotedAmount          Int?           @map("quoted_amount")
  currency              Currency       @default(GBP)
  quotedCompletionDate  DateTime?      @map("quoted_completion_date")
  quoteNote             String?        @map("quote_note")
  quoteExpiresAt        DateTime?      @map("quote_expires_at")
  stage                 OrderStage     @default(DRAFT)
  stageUpdatedAt        DateTime       @default(now()) @map("stage_updated_at")
  paymentProvider       PaymentProvider? @map("payment_provider")
  paymentIntentId       String?        @map("payment_intent_id")
  escrowReleased        Boolean        @default(false) @map("escrow_released")
  escrowReleasedAt      DateTime?      @map("escrow_released_at")
  autoReleaseAt         DateTime?      @map("auto_release_at")
  collectionCode        String?        @map("collection_code")
  collectionCodeExpiry  DateTime?      @map("collection_code_expiry")
  collectionCodeUsed    Boolean        @default(false) @map("collection_code_used")
  disputeId             String?        @map("dispute_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  stageHistory    OrderStageUpdate[]
  referencePhotos OrderPhoto[]
  messages        Message[]
  review          Review?
  dispute         Dispute?

  @@map("orders")
}

// ─────────────────────────────────────────────
// ORDER STAGE UPDATES
// ─────────────────────────────────────────────

model OrderStageUpdate {
  id       String     @id @default(uuid())
  orderId  String     @map("order_id")
  order    Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage    OrderStage
  note     String?
  photoUrl String?    @map("photo_url")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("order_stage_updates")
}

// ─────────────────────────────────────────────
// ORDER PHOTOS
// ─────────────────────────────────────────────

model OrderPhoto {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storagePath String   @map("storage_path")
  publicUrl   String   @map("public_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("order_photos")
}

// ─────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────

model Message {
  id       String      @id @default(uuid())
  orderId  String      @map("order_id")
  order    Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId String      @map("sender_id")
  sender   User        @relation("SentMessages", fields: [senderId], references: [id])
  type     MessageType @default(TEXT)
  content  String?
  mediaUrl String?     @map("media_url")
  duration Int?
  readAt   DateTime?   @map("read_at")
  blocked  Boolean     @default(false)
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("messages")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id              String        @id @default(uuid())
  orderId         String        @unique @map("order_id")
  order           Order         @relation(fields: [orderId], references: [id])
  tailorProfileId String        @map("tailor_profile_id")
  tailor          TailorProfile @relation("TailorReviews", fields: [tailorProfileId], references: [id])

  rating            Int
  content           String?
  tags              String[]
  tailorResponse    String?   @map("tailor_response")
  tailorRespondedAt DateTime? @map("tailor_responded_at")
  publishedAt       DateTime? @map("published_at")
  flagged           Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("reviews")
}

// ─────────────────────────────────────────────
// DISPUTES
// ─────────────────────────────────────────────

model Dispute {
  id       String @id @default(uuid())
  orderId  String @unique @map("order_id")
  order    Order  @relation(fields: [orderId], references: [id])

  reason       String
  description  String
  evidenceUrls String[]      @map("evidence_urls")
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?     @map("resolved_at")
  resolvedBy   String?       @map("resolved_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("disputes")
}

// ─────────────────────────────────────────────
// PAYOUTS
// ─────────────────────────────────────────────

model Payout {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id])

  amount          Int
  currency        Currency
  provider        PaymentProvider
  providerPayoutId String?       @map("provider_payout_id")
  orderId         String?        @map("order_id")
  processedAt     DateTime       @default(now()) @map("processed_at")

  @@map("payouts")
}

// ─────────────────────────────────────────────
// CONTACT BYPASS LOG
// ─────────────────────────────────────────────

model ContactBypassLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  surface    String
  content    String
  attempt    Int
  reviewed   Boolean  @default(false)
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy String?   @map("reviewed_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("contact_bypass_logs")
}
