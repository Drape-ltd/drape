// Drape V1 — Prisma Schema
// Auth users are managed by Supabase Auth (auth.users).
// All tables reference user_id as a plain String (the auth UUID) — no FK to auth.users.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum GarmentContext {
  MENSWEAR
  WOMENSWEAR
  BOTH
  PREFER_NOT_TO_SAY

  @@map("garment_context")
}

enum BodyShape {
  RECTANGLE
  BROAD_SHOULDERS
  FULL_HIPS
  DEFINED_WAIST
  FULL_MIDSECTION
  ATHLETIC
  PREFER_NOT_TO_SAY

  @@map("body_shape")
}

enum FitStyle {
  SLIM
  REGULAR
  RELAXED

  @@map("fit_style")
}

enum TailorTier {
  VERIFIED
  RISING
  MASTER

  @@map("tailor_tier")
}

enum AvailabilityStatus {
  OPEN
  LIMITED
  FULLY_BOOKED

  @@map("availability_status")
}

enum SellerType {
  TAILOR
  BOUTIQUE
  TAILOR_SHOP

  @@map("seller_type")
}

enum FabricSource {
  CUSTOMER_SUPPLIES
  TAILOR_SOURCES

  @@map("fabric_source")
}

enum DeliveryMethod {
  SHIPPING
  LOCAL_COLLECTION

  @@map("delivery_method")
}

enum OrderKind {
  CUSTOM
  READY_MADE

  @@map("order_kind")
}

enum OrderStage {
  DRAFT
  PENDING_QUOTE
  CONSULTATION
  QUOTE_SENT
  PAYMENT_PENDING
  CONFIRMED
  DESIGNING
  SOURCING
  CUTTING
  SEWING
  FINISHING
  SHIPPED
  READY_FOR_COLLECTION
  DELIVERED
  COLLECTED
  COMPLETE
  DECLINED
  EXPIRED
  IN_DISPUTE
  REFUNDED
  CANCELLED

  @@map("order_stage")
}

enum Currency {
  GBP
  USD
  EUR
  NGN
  GHS
  KES

  @@map("currency")
}

enum PaymentProvider {
  STRIPE
  PAYSTACK

  @@map("payment_provider")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_RELEASED

  @@map("dispute_status")
}

enum ClientType {
  ON_DRAPE
  PRIVATE

  @@map("client_type")
}

enum MessageType {
  TEXT
  PHOTO
  VOICE_NOTE

  @@map("message_type")
}

// ─────────────────────────────────────────────
// CUSTOMER PROFILE
// Keyed on user_id (Supabase auth UUID).
// ─────────────────────────────────────────────

model CustomerProfile {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  displayName String? @map("display_name")

  // JSONB blob — written by the measurements wizard in the mobile app.
  // Shape: { chest, waist, hips, inseam, shoulder, sleeveLength, neck, height,
  //          unit ("cm"|"in"), fitStyle, garmentContext, bodyShape, fitFlags[], bodyNote }
  measurements Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

// ─────────────────────────────────────────────
// TAILOR PROFILE
// ─────────────────────────────────────────────

model TailorProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  displayName          String             @map("display_name")
  businessName         String?            @map("business_name")
  sellerType           SellerType         @default(TAILOR) @map("seller_type")
  bio                  String?
  location             String             @default("")
  languages            String[]
  specialtyTags        String[]           @map("specialty_tags")
  priceRangeMin        Int?               @map("price_range_min")
  priceRangeMax        Int?               @map("price_range_max")
  currency             Currency           @default(GBP)
  tier                 TailorTier         @default(VERIFIED)
  availability         AvailabilityStatus @default(OPEN)
  isVerified           Boolean            @default(false) @map("is_verified")
  isLive               Boolean            @default(false) @map("is_live")
  avgRating            Float              @default(0) @map("avg_rating")
  totalReviews         Int                @default(0) @map("total_reviews")
  totalOrders          Int                @default(0) @map("total_orders")
  avgResponseHours     Float?             @map("avg_response_hours")
  supportsCustomOrders Boolean            @default(true) @map("supports_custom_orders")
  supportsReadyMade    Boolean            @default(false) @map("supports_ready_made")
  pickupAvailable      Boolean            @default(false) @map("pickup_available")
  deliveryAvailable    Boolean            @default(false) @map("delivery_available")
  shippingAvailable    Boolean            @default(false) @map("shipping_available")
  shipsInternationally Boolean            @default(false) @map("ships_internationally")
  stripeAccountId      String?            @map("stripe_account_id")
  paystackAccountId    String?            @map("paystack_account_id")
  idVerificationStatus String             @default("NOT_SUBMITTED") @map("id_verification_status")
  idDocumentPath       String?            @map("id_document_path")
  idDocumentUrl        String?            @map("id_document_url")
  idVerifiedAt         DateTime?          @map("id_verified_at")
  // Flat URL array written by the setup wizard (source of truth for mobile)
  portfolioPhotoUrls   String[]           @map("portfolio_photo_urls")
  bypassAttempts       Int                @default(0) @map("bypass_attempts")
  tierLostAt           DateTime?          @map("tier_lost_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  portfolioPhotos PortfolioPhoto[]
  sellerItems     SellerItem[]
  orders          Order[]
  clients         TailorClient[]
  reviews         Review[]
  payouts         Payout[]

  @@map("tailor_profiles")
}

// ─────────────────────────────────────────────
// PORTFOLIO PHOTOS (admin / CDN record)
// ─────────────────────────────────────────────

model PortfolioPhoto {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  storagePath   String    @map("storage_path")
  publicUrl     String    @map("public_url")
  caption       String?
  displayOrder  Int       @default(0) @map("display_order")
  ocrFlagged    Boolean   @default(false) @map("ocr_flagged")
  ocrReviewedAt DateTime? @map("ocr_reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("portfolio_photos")
}

model SellerItem {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  title             String
  description       String?
  category          String?
  sizes             String[]
  priceAmount       Int      @map("price_amount")
  currency          Currency @default(GBP)
  photoUrls         String[] @default([]) @map("photo_urls")
  isReadyMade       Boolean  @default(true) @map("is_ready_made")
  isLive            Boolean  @default(false) @map("is_live")
  stockStatus       String   @default("IN_STOCK") @map("stock_status")
  pickupAvailable   Boolean  @default(false) @map("pickup_available")
  deliveryAvailable Boolean  @default(false) @map("delivery_available")
  shippingAvailable Boolean  @default(false) @map("shipping_available")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("seller_items")
}

// ─────────────────────────────────────────────
// TAILOR CRM — ON DRAPE CLIENTS (private fit notes)
// ─────────────────────────────────────────────

model TailorClientNote {
  id         String   @id @default(uuid())
  tailorId   String   @map("tailor_id")   // tailor auth UUID
  customerId String   @map("customer_id") // customer auth UUID
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tailorId, customerId])
  @@map("tailor_client_notes")
}

// ─────────────────────────────────────────────
// TAILOR CRM — PRIVATE (offline) CLIENTS
// ─────────────────────────────────────────────

model TailorClient {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  clientType          ClientType @default(PRIVATE) @map("client_type")
  linkedUserId        String?    @map("linked_user_id")
  name                String
  email               String?
  phone               String?
  chestCm             Float?     @map("chest_cm")
  waistCm             Float?     @map("waist_cm")
  hipsCm              Float?     @map("hips_cm")
  shoulderWidthCm     Float?     @map("shoulder_width_cm")
  inseamCm            Float?     @map("inseam_cm")
  sleeveLengthCm      Float?     @map("sleeve_length_cm")
  neckCircumferenceCm Float?     @map("neck_circumference_cm")
  heightCm            Float?     @map("height_cm")
  fitNotes            String?    @map("fit_notes")
  generalNotes        String?    @map("general_notes")
  inviteToken         String?    @unique @map("invite_token")
  inviteSentAt        DateTime?  @map("invite_sent_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  offlineOrders OfflineOrder[]

  @@map("tailor_clients")
}

// ─────────────────────────────────────────────
// OFFLINE ORDERS
// ─────────────────────────────────────────────

model OfflineOrder {
  id             String       @id @default(uuid())
  tailorClientId String       @map("tailor_client_id")
  tailorClient   TailorClient @relation(fields: [tailorClientId], references: [id], onDelete: Cascade)

  garmentType String    @map("garment_type")
  description String?
  price       Int?
  currency    Currency  @default(GBP)
  status      String    @default("completed")
  notes       String?
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("offline_orders")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id         String @id @default(uuid())
  reference  String @unique @default(cuid())
  customerId String @map("customer_id") // customer auth UUID
  tailorId   String @map("tailor_id")   // tailor auth UUID

  // Optional FK to tailor_profiles for joins (populated on order creation)
  tailorProfileId String?        @map("tailor_profile_id")
  tailorProfile   TailorProfile? @relation(fields: [tailorProfileId], references: [id])
  orderKind       OrderKind      @default(CUSTOM) @map("order_kind")
  sellerItemId    String?        @map("seller_item_id")
  fulfillmentOption String?      @map("fulfillment_option")

  garmentType                  String          @map("garment_type")
  garmentDescription           String?         @map("garment_description")
  itemTitle                    String?         @map("item_title")
  itemSize                     String?         @map("item_size")
  itemQuantity                 Int             @default(1) @map("item_quantity")
  itemUnitPrice                Int?            @map("item_unit_price")
  itemSubtotal                 Int?            @map("item_subtotal")
  occasion                     String?
  deadline                     DateTime?
  fabricSource                 FabricSource?   @map("fabric_source")
  deliveryMethod               DeliveryMethod? @map("delivery_method")
  specialNote                  String?         @map("special_note")
  fabricTracking               String?         @map("fabric_tracking")
  referencePhotos              String[]        @default([]) @map("reference_photos")
  customerMeasurementsSnapshot Json?           @map("customer_measurements_snapshot")
  fitNote                      String?         @map("fit_note")
  consultationFee              Int?            @map("consultation_fee")
  quotedAmount                 Int?            @map("quoted_amount")
  currency                     Currency        @default(GBP)
  quotedCompletionDate         DateTime?       @map("quoted_completion_date")
  quoteNote                    String?         @map("quote_note")
  quoteExpiresAt               DateTime?       @map("quote_expires_at")
  stage                        OrderStage      @default(DRAFT)
  stageUpdatedAt               DateTime        @default(now()) @map("stage_updated_at")
  paymentProvider              PaymentProvider? @map("payment_provider")
  paymentIntentId              String?         @map("payment_intent_id")
  escrowReleased               Boolean         @default(false) @map("escrow_released")
  escrowReleasedAt             DateTime?       @map("escrow_released_at")
  autoReleaseAt                DateTime?       @map("auto_release_at")
  collectionCode               String?         @map("collection_code")
  collectionCodeExpiry         DateTime?       @map("collection_code_expiry")
  collectionCodeUsed           Boolean         @default(false) @map("collection_code_used")
  createdAt                    DateTime        @default(now()) @map("created_at")
  updatedAt                    DateTime        @updatedAt @map("updated_at")

  stageHistory OrderStageUpdate[]
  orderPhotos  OrderPhoto[]
  messages     Message[]
  review       Review?
  dispute      Dispute?

  @@map("orders")
}

// ─────────────────────────────────────────────
// ORDER STAGE UPDATES
// ─────────────────────────────────────────────

model OrderStageUpdate {
  id        String     @id @default(uuid())
  orderId   String     @map("order_id")
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage     OrderStage
  note      String?
  photoUrl  String?    @map("photo_url")
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("order_stage_updates")
}

// ─────────────────────────────────────────────
// ORDER PHOTOS
// ─────────────────────────────────────────────

model OrderPhoto {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storagePath String   @map("storage_path")
  publicUrl   String   @map("public_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("order_photos")
}

// ─────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────

model Message {
  id          String      @id @default(uuid())
  orderId     String      @map("order_id")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId    String      @map("sender_id") // auth UUID
  senderRole  String      @map("sender_role") // CUSTOMER | TAILOR
  senderName  String      @map("sender_name")
  type        MessageType @default(TEXT)
  body        String?
  photoUrl    String?     @map("photo_url")
  voiceUrl    String?     @map("voice_url")
  readAt      DateTime?   @map("read_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("messages")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id              String  @id @default(uuid())
  orderId         String  @unique @map("order_id")
  order           Order   @relation(fields: [orderId], references: [id])
  tailorProfileId String? @map("tailor_profile_id")
  tailorProfile   TailorProfile? @relation(fields: [tailorProfileId], references: [id])
  tailorId        String? @map("tailor_id") // tailor auth UUID for simple queries

  rating            Int
  body              String?   // written review text
  tags              String[]
  reviewerName      String?   @map("reviewer_name") // "First L."
  tailorResponse    String?   @map("tailor_response")
  tailorRespondedAt DateTime? @map("tailor_responded_at")
  publishedAt       DateTime? @map("published_at")
  flagged           Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("reviews")
}

// ─────────────────────────────────────────────
// DISPUTES
// ─────────────────────────────────────────────

model Dispute {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  reason       String
  description  String
  evidenceUrls String[]      @default([]) @map("evidence_urls")
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?     @map("resolved_at")
  resolvedBy   String?       @map("resolved_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("disputes")
}

// ─────────────────────────────────────────────
// PAYOUTS
// ─────────────────────────────────────────────

model Payout {
  id              String        @id @default(uuid())
  tailorProfileId String        @map("tailor_profile_id")
  tailorProfile   TailorProfile @relation(fields: [tailorProfileId], references: [id])

  amount           Int
  currency         Currency
  provider         PaymentProvider
  providerPayoutId String?         @map("provider_payout_id")
  orderId          String?         @map("order_id")
  processedAt      DateTime        @default(now()) @map("processed_at")

  @@map("payouts")
}

// ─────────────────────────────────────────────
// PUSH TOKENS
// ─────────────────────────────────────────────

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("push_tokens")
}

// ─────────────────────────────────────────────
// CONTACT BYPASS LOG
// ─────────────────────────────────────────────

model ContactBypassLog {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  surface    String
  content    String
  attempt    Int
  reviewed   Boolean   @default(false)
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy String?   @map("reviewed_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("contact_bypass_logs")
}
