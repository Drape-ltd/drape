// Drape V1 â Prisma Schema
// Mirrors Supabase PostgreSQL. RLS is enforced at the DB level.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  TAILOR
}

enum GarmentContext {
  MENSWEAR
  WOMENSWEAR
  BOTH
  PREFER_NOT_TO_SAY
}

enum BodyShape {
  RECTANGLE
  BROAD_SHOULDERS
  FULL_HIPS
  DEFINED_WAIST
  FULL_MIDSECTION
  ATHLETIC
  PREFER_NOT_TO_SAY
}

enum FitStyle {
  SLIM
  REGULAR
  RELAXED
}

enum TailorTier {
  VERIFIED
  RISING
  MASTER
}

enum AvailabilityStatus {
  OPEN
  LIMITED
  FULLY_BOOKED
}

enum FabricSource {
  CUSTOMER_SUPPLIED
  TAILOR_SOURCES
}

enum DeliveryMethod {
  SHIPPING
  LOCAL_COLLECTION
}

enum OrderStage {
  DRAFT
  PENDING_QUOTE
  QUOTE_SENT
  PAYMENT_PENDING
  CONFIRMED
  CUTTING
  SEWING
  FINISHING
  SHIPPED
  READY_FOR_COLLECTION
  DELIVERED
  COLLECTED
  COMPLETE
  DECLINED
  EXPIRED
  IN_DISPUTE
  REFUNDED
  CANCELLED
}

enum Currency {
  GBP
  USD
  EUR
  NGN
  GHS
  KES
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  RESOLVED_RELEASED
}

enum ClientType {
  ON_DRAPE
  PRIVATE
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id          String   @id @default(uuid()) // matches Supabase auth.users.id
  email       String   @unique
  displayName String
  role        UserRole
  phone       String?  // private, never shown publicly
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  customerProfile  CustomerProfile?
  tailorProfile    TailorProfile?
  ordersAsCustomer Order[]          @relation("CustomerOrders")
  sentMessages     Message[]        @relation("SentMessages")

  @@map("users")
}

// ─────────────────────────────────────────────
// CUSTOMER PROFILE
// ─────────────────────────────────────────────

model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Layer 1 â Measurements
  chestCm         Float?
  waistCm         Float?
  hipsCm          Float?
  shoulderWidthCm Float?
  inseamCm        Float?
  sleeveLengthCm  Float?
  neckCircumferenceCm Float?
  heightCm        Float?
  fitStyle        FitStyle?
  unitPreference  String   @default("cm") // "cm" | "inches"

  // Layer 2 â Garment context
  garmentContext  GarmentContext?

  // Layer 3 â Body shape
  bodyShape       BodyShape?

  // Layer 4 â Fit challenge flags (stored as array of enum strings)
  fitFlags        String[] // e.g. ["LARGE_THIGHS", "BROAD_SHOULDERS"]

  // Free-text body note (max 150 chars)
  bodyNote        String?

  // Prompt tracking
  completionPromptShown Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

// ─────────────────────────────────────────────
// TAILOR PROFILE
// ─────────────────────────────────────────────

model TailorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName       String
  businessName      String?
  bio               String?
  location          String
  languages         String[]
  specialtyTags     String[]
  priceRangeMin     Int?      // in pence/kobo (smallest currency unit)
  priceRangeMax     Int?
  currency          Currency  @default(GBP)
  tier              TailorTier @default(VERIFIED)
  availability      AvailabilityStatus @default(OPEN)
  isVerified        Boolean   @default(false)
  isLive            Boolean   @default(false) // true after ID approved + 4 photos + payout
  avgRating         Float     @default(0)
  totalReviews      Int       @default(0)
  totalOrders       Int       @default(0)
  avgResponseHours  Float?
  shipsInternationally Boolean @default(false)

  // Stripe / Paystack
  stripeAccountId   String?
  paystackAccountId String?

  // ID verification
  idDocumentPath    String?   // Supabase storage path
  idVerifiedAt      DateTime?

  // Contact bypass tracking
  bypassAttempts    Int       @default(0)
  tierLostAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolioPhotos   PortfolioPhoto[]
  orders            Order[]          @relation("TailorOrders")
  clients           TailorClient[]
  reviews           Review[]         @relation("TailorReviews")

  @@map("tailor_profiles")
}

// ─────────────────────────────────────────────
// PORTFOLIO
// ─────────────────────────────────────────────

model PortfolioPhoto {
  id            String        @id @default(uuid())
  tailorProfileId String
  tailorProfile TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  storagePath   String  // Supabase Storage path
  publicUrl     String
  caption       String?
  displayOrder  Int     @default(0)

  // OCR moderation
  ocrFlagged    Boolean   @default(false)
  ocrReviewedAt DateTime?

  createdAt DateTime @default(now())

  @@map("portfolio_photos")
}

// ─────────────────────────────────────────────
// TAILOR CRM â CLIENTS
// ─────────────────────────────────────────────

model TailorClient {
  id            String        @id @default(uuid())
  tailorProfileId String
  tailorProfile TailorProfile @relation(fields: [tailorProfileId], references: [id], onDelete: Cascade)

  clientType    ClientType    @default(PRIVATE)
  // If ON_DRAPE, links to user
  linkedUserId  String?

  // Stored for both private and on-drape clients
  name          String
  email         String?       // private, tailor-only
  phone         String?       // private, tailor-only

  // Measurements (manually entered for private clients)
  chestCm         Float?
  waistCm         Float?
  hipsCm          Float?
  shoulderWidthCm Float?
  inseamCm        Float?
  sleeveLengthCm  Float?
  neckCircumferenceCm Float?
  heightCm        Float?

  fitNotes      String?   // private tailor notes per client
  generalNotes  String?   // "Likes Ankara but not Kente. Birthday August."

  // Invite
  inviteToken   String?   @unique
  inviteSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offlineOrders OfflineOrder[]

  @@map("tailor_clients")
}

// ─────────────────────────────────────────────
// OFFLINE ORDERS (CRM â manual logging)
// ─────────────────────────────────────────────

model OfflineOrder {
  id             String       @id @default(uuid())
  tailorClientId String
  tailorClient   TailorClient @relation(fields: [tailorClientId], references: [id], onDelete: Cascade)

  garmentType    String
  description    String?
  price          Int?         // in smallest currency unit
  currency       Currency     @default(GBP)
  status         String       @default("completed")
  notes          String?
  completedAt    DateTime?

  createdAt DateTime @default(now())

  @@map("offline_orders")
}

// ─────────────────────────────────────────────
// ORDERS (platform orders)
// ─────────────────────────────────────────────

model Order {
  id              String   @id @default(uuid())
  reference       String   @unique @default(cuid())

  customerId      String
  customer        User     @relation("CustomerOrders", fields: [customerId], references: [id])

  tailorProfileId String
  tailor          TailorProfile @relation("TailorOrders", fields: [tailorProfileId], references: [id])

  // Brief
  garmentType     String
  description     String
  occasion        String?
  deadline        DateTime?
  fabricSource    FabricSource
  deliveryMethod  DeliveryMethod
  specialNote     String?
  fabricTracking  String?  // tracking number if customer supplied

  // Quote
  quotedAmount    Int?     // in smallest currency unit
  currency        Currency @default(GBP)
  quotedCompletionDate DateTime?
  quoteNote       String?
  quoteExpiresAt  DateTime?

  // State
  stage           OrderStage @default(DRAFT)
  stageUpdatedAt  DateTime   @default(now())

  // Payment
  paymentProvider PaymentProvider?
  paymentIntentId String?  // Stripe PaymentIntent or Paystack reference
  escrowReleased  Boolean  @default(false)
  escrowReleasedAt DateTime?
  autoReleaseAt   DateTime? // 14 days after shipped

  // Collection
  collectionCode        String?   // 4-digit, hashed
  collectionCodeExpiry  DateTime?
  collectionCodeUsed    Boolean   @default(false)

  // Dispute
  disputeId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageHistory    OrderStageUpdate[]
  referencePhotos OrderPhoto[]       @relation("ReferencePhotos")
  messages        Message[]
  review          Review?
  dispute         Dispute?

  @@map("orders")
}

// ─────────────────────────────────────────────
// ORDER STAGE UPDATES (timeline)
// ─────────────────────────────────────────────

model OrderStageUpdate {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stage   OrderStage
  note    String?
  photoUrl String?  // Supabase Storage URL

  createdAt DateTime @default(now())

  @@map("order_stage_updates")
}

// ─────────────────────────────────────────────
// ORDER PHOTOS (reference photos from customer)
// ─────────────────────────────────────────────

model OrderPhoto {
  id          String @id @default(uuid())
  orderId     String
  order       Order  @relation("ReferencePhotos", fields: [orderId], references: [id], onDelete: Cascade)

  storagePath String
  publicUrl   String

  createdAt DateTime @default(now())

  @@map("order_photos")
}

// ─────────────────────────────────────────────
// MESSAGES
// ─────────────────────────────────────────────

enum MessageType {
  TEXT
  PHOTO
  VOICE_NOTE
}

model Message {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  type     MessageType @default(TEXT)
  content  String?     // text content
  mediaUrl String?     // Supabase Storage URL for photo/voice
  duration Int?        // voice note duration in seconds

  readAt   DateTime?

  // Moderation
  blocked  Boolean   @default(false)

  createdAt DateTime @default(now())

  @@map("messages")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  tailorProfileId String
  tailor          TailorProfile @relation("TailorReviews", fields: [tailorProfileId], references: [id])

  rating     Int      // 1â5
  content    String?
  tags       String[] // ["PERFECT_FIT", "GREAT_COMMUNICATION", ...]

  // Tailor response
  tailorResponse   String?
  tailorRespondedAt DateTime?

  // Moderation
  publishedAt DateTime? // 10-min hold before publish
  flagged     Boolean   @default(false)

  createdAt DateTime @default(now())

  @@map("reviews")
}

// ─────────────────────────────────────────────
// DISPUTES
// ─────────────────────────────────────────────

model Dispute {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  reason      String
  description String
  evidenceUrls String[]

  status      DisputeStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?
  resolvedBy  String?       // admin user id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("disputes")
}

// ─────────────────────────────────────────────
// PAYOUTS
// ─────────────────────────────────────────────

model Payout {
  id              String @id @default(uuid())
  tailorProfileId String

  amount          Int      // in smallest currency unit
  currency        Currency
  provider        PaymentProvider
  providerPayoutId String?
  orderId         String?  // which order triggered this payout

  processedAt     DateTime @default(now())

  @@map("payouts")
}

// ─────────────────────────────────────────────
// CONTACT BYPASS LOG (moderation)
// ─────────────────────────────────────────────

model ContactBypassLog {
  id        String   @id @default(uuid())
  userId    String
  surface   String   // "chat", "bio", "review", "brief", "display_name"
  content   String   // the blocked content
  attempt   Int      // which attempt number for this user
  reviewed  Boolean  @default(false)
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())

  @@map("contact_bypass_logs")
}
