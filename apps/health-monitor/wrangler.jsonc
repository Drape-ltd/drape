{
  "$schema": "../web/node_modules/wrangler/config-schema.json",
  "name": "drapeon-health-monitor",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-31",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "SLACK_CHANNEL_ID": "C0BSXPAGVEX"
  },
  "kv_namespaces": [
    {
      "binding": "HEALTH_STATE",
      "id": "5e54bee9cb8f411d875c6c8ca6bb48c3"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
