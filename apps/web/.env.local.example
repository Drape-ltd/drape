NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SITE_URL=https://drapeon.co
NEXT_PUBLIC_QUOTE_NEGOTIATION_V1=false
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.pqptfuqogvrajozfsqzi.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.pqptfuqogvrajozfsqzi.supabase.co:5432/postgres
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
RESEND_API_KEY=your_resend_api_key_here
