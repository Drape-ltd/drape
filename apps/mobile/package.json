{
  "name": "@drape/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "./entry.js",
  "scripts": {
    "dev": "node ./scripts/run-with-env-guard.mjs development expo start",
    "android": "node ./scripts/run-with-env-guard.mjs development expo run:android",
    "ios": "node ./scripts/run-with-env-guard.mjs development expo run:ios",
    "build:ios": "node ./scripts/run-with-env-guard.mjs preview eas build --platform ios --profile preview",
    "build:android": "node ./scripts/run-with-env-guard.mjs preview eas build --platform android --profile preview",
    "build:ios:prod": "node ./scripts/run-with-env-guard.mjs production eas build --platform ios --profile production",
    "build:android:prod": "node ./scripts/run-with-env-guard.mjs production eas build --platform android --profile production",
    "prepare:native-dependencies": "node ./scripts/materialize-native-dependencies.mjs",
    "eas-build-post-install": "node ./scripts/prepare-google-services.mjs && node ./scripts/materialize-native-dependencies.mjs",
    "qa:android": "node ./scripts/android-qa-runner.mjs",
    "lint": "eslint app components lib constants --max-warnings=999 && node scripts/check-navigation-usage.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drape/drape-vision": "workspace:*",
    "@drape/shared": "workspace:*",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@sentry/react-native": "^7.2.0",
    "@shopify/flash-list": "^2.3.2",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "^8.0.8",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "^14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "^15.0.10",
    "posthog-react-native": "^4.37.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^3.1.0",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-nitro-image": "0.14.0",
    "react-native-nitro-modules": "0.35.6",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vision-camera": "5.1.1",
    "react-native-vision-camera-worklets": "5.1.1",
    "react-native-worklets": "~0.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@sentry/cli": "2.55.0",
    "@types/react": "~19.1.17",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "babel-preset-expo": "54.0.10",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "typescript": "^5.7.2"
  }
}
