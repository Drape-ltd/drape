# Copy this to .env.local and fill in your values.
# .env.local       → development (your dev Supabase project)
# .env.production  → production  (create a separate Supabase project before launch)
# Non-production mobile builds should never point at production data.

EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
EXPO_PUBLIC_SUPABASE_PROJECT_REF=your-dev-project
EXPO_PUBLIC_SUPABASE_ENV=development
EXPO_PUBLIC_PROJECT_ID=your_expo_project_id_here
# Optional for Stripe-backed currencies in non-production builds.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
EXPO_PUBLIC_SITE_URL=https://drapeon.co

# Required before beta crash diagnostics can leave the device.
EXPO_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/project-id
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Build-only EAS secrets required before setting SENTRY_DISABLE_AUTO_UPLOAD=false:
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# Optional local read-only Sentry monitoring for `pnpm beta:logs`.
# Create a separate Internal Integration token with only org/project/event read access.
SENTRY_MONITOR_TOKEN=your_read_only_sentry_token
SENTRY_MONITOR_ORG=your_sentry_organization_slug
SENTRY_MONITOR_PROJECTS=drape-mobile,deno

# Launch-critical features. Enable in development/preview first.
EXPO_PUBLIC_DRAPE_INTERACTION_SYSTEM_V1=false
EXPO_PUBLIC_QUOTE_NEGOTIATION_V1=false
EXPO_PUBLIC_CHAT_ORDER_ACTIONS_V1=false
EXPO_PUBLIC_DRAPE_VISION_UI_V2=false
