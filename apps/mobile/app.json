{
  "expo": {
    "name": "Drapeon",
    "slug": "drape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "drape",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F7F3",
      "dark": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#1A1A18"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "W84Q46T4XF",
      "bundleIdentifier": "co.drapeon.app",
      "associatedDomains": [
        "applinks:drapeon.co",
        "applinks:www.drapeon.co"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "voip"
        ],
        "NSCameraUsageDescription": "Drapeon uses your camera for protected order calls, reference photos, portfolio videos, progress updates, and Drapeon Vision scans.",
        "NSPhotoLibraryUsageDescription": "Drapeon accesses your photo library for order references and portfolio photos or videos.",
        "NSMicrophoneUsageDescription": "Drapeon uses your microphone for protected order calls and voice note messages.",
        "NSMotionUsageDescription": "Drapeon uses device motion to keep Drapeon Vision scans calibrated while you turn.",
        "NSFaceIDUsageDescription": "Drapeon uses Face ID to quickly and securely verify your identity when you return to the app."
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "splash": {
        "image": "./assets/adaptive-icon-foreground.png",
        "resizeMode": "contain",
        "backgroundColor": "#F9F7F3",
        "dark": {
          "image": "./assets/adaptive-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1A18"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#2D6A4F"
      },
      "package": "com.drape.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "drapeon.co",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "drapeon.co",
              "pathPrefix": "/payments"
            },
            {
              "scheme": "https",
              "host": "drapeon.co",
              "pathPrefix": "/verify-handoff"
            },
            {
              "scheme": "https",
              "host": "www.drapeon.co",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "www.drapeon.co",
              "pathPrefix": "/payments"
            },
            {
              "scheme": "https",
              "host": "www.drapeon.co",
              "pathPrefix": "/verify-handoff"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Drapeon uses your camera for photos and video."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Drapeon uses your photo library so you can upload portfolio photos, videos, and order references. Your media is only accessed when you choose to upload.",
          "cameraPermission": "Drapeon uses your camera to take portfolio photos, videos, and order references."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Drapeon uses device motion to keep Drapeon Vision scans calibrated while you turn."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6A4F",
          "defaultChannel": "default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Drapeon uses your microphone to record voice note messages."
        }
      ],
      "expo-apple-authentication",
      [
        "@stripe/stripe-react-native",
        {}
      ],
      [
        "@daily-co/config-plugin-rn-daily-js",
        {
          "enableCamera": true,
          "enableMicrophone": true,
          "enableScreenShare": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/with-vision-camera-ios-build-settings",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4729d6f8-273a-43a9-abdf-6e4ca31ce83d"
      }
    },
    "owner": "dimowoope"
  }
}
