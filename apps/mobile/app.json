{
  "expo": {
    "name": "Drape",
    "slug": "drape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "drape",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A18"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.drape.app",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Drape uses your camera to upload reference photos, progress updates, and Drape Vision scans.",
        "NSPhotoLibraryUsageDescription": "Drape accesses your photo library for order references and portfolio photos.",
        "NSMicrophoneUsageDescription": "Drape uses your microphone for voice note messages.",
        "NSMotionUsageDescription": "Drape uses device motion to keep Drape Vision scans calibrated while you turn.",
        "NSFaceIDUsageDescription": "Drape uses Face ID to quickly and securely verify your identity when you return to the app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2D6A4F"
      },
      "package": "com.drape.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Drape uses your camera for photos and video."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Drape uses your photo library so you can upload portfolio photos and order references. Your photos are only accessed when you choose to upload.",
          "cameraPermission": "Drape uses your camera to take portfolio photos and order references."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Drape uses device motion to keep Drape Vision scans calibrated while you turn."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2D6A4F",
          "sounds": []
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Drape uses your microphone to record voice note messages."
        }
      ],
      "expo-apple-authentication",
      [
        "@stripe/stripe-react-native",
        {}
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4729d6f8-273a-43a9-abdf-6e4ca31ce83d"
      }
    },
    "owner": "dimowoope"
  }
}
