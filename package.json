{
  "name": "drape",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "qa:android": "pnpm --dir apps/mobile qa:android",
    "mobile:release-target:check": "node scripts/mobile-release-target-guard.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @drape/db generate",
    "db:push": "pnpm --filter @drape/db db:push",
    "db:migrate": "pnpm --filter @drape/db migrate",
    "db:studio": "pnpm --filter @drape/db studio",
    "supabase:status": "node scripts/supabase-target-guard.mjs status",
    "supabase:link:dev": "node scripts/supabase-target-guard.mjs link development",
    "supabase:link:prod": "node scripts/supabase-target-guard.mjs link production",
    "supabase:db:push:dev": "node scripts/supabase-target-guard.mjs db:push development",
    "supabase:db:push:prod": "node scripts/supabase-target-guard.mjs db:push production",
    "supabase:secrets:manifest": "node scripts/supabase-target-guard.mjs secrets:manifest",
    "supabase:secrets:set:dev": "node scripts/supabase-target-guard.mjs secrets:set development",
    "supabase:secrets:set:prod": "node scripts/supabase-target-guard.mjs secrets:set production",
    "supabase:functions:deploy:dev": "node scripts/supabase-target-guard.mjs functions:deploy development",
    "supabase:functions:deploy:prod": "node scripts/supabase-target-guard.mjs functions:deploy production",
    "supabase:functions:deploy:all:dev": "node scripts/supabase-target-guard.mjs functions:deploy-all development",
    "supabase:functions:deploy:all:prod": "node scripts/supabase-target-guard.mjs functions:deploy-all production",
    "security:edge-auth": "node scripts/check-edge-auth.mjs",
    "launch:contracts": "node scripts/launch-contract-check.mjs",
    "launch:contracts:linked": "node scripts/launch-contract-check.mjs --with-supabase",
    "commercial:contracts": "node scripts/check-commercial-contract-parity.mjs",
    "communications:contracts": "node scripts/check-communications-contract-parity.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "beta:logs": "node scripts/beta-logs.mjs",
    "seed:store-demo": "node scripts/seed-store-demo.mjs",
    "seed:store-demo:ledger": "node scripts/build-store-showcase-ledger.mjs",
    "seed:store-demo:cleanup": "node scripts/cleanup-store-demo.mjs",
    "seed:launch-tailors": "node scripts/seed-launch-tailors.mjs",
    "seed:stripe-qa": "node scripts/seed-stripe-qa.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "@stripe/stripe-react-native@0.50.3": "patches/@stripe__stripe-react-native@0.50.3.patch",
      "react-native-vision-camera@5.1.1": "patches/react-native-vision-camera@5.1.1.patch"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6"
  }
}
