{
  "name": "drape",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @drape/db generate",
    "db:push": "pnpm --filter @drape/db db:push",
    "db:migrate": "pnpm --filter @drape/db migrate",
    "db:studio": "pnpm --filter @drape/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
